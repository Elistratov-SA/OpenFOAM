FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// user vars //

ND      10;               // cell per diam
D       0.025;            // diam
f50       #calc "1*$D";   // refinement half-width (no more than yc!)
zc        #calc "4*$D";   // nozzle center height over floor
domainExpansion  2;      // whole domain downstream expansion
refinementExpansion  #calc "$domainExpansion" ; // refinement area expatsion to outflow

gradingDownstream 10; // >1 to expand from the nozzle
gradingFloor 3; // >1 to expand from nozzle to floor
gradingOuter 5;  // >1 to expand in the outer space

H       #calc "20*$D";   // domain height (floor to ceil)
L       #calc "60*$D";   // domain length (downstream)
w50       #calc "10*$D";  // spanwise, half-size

yb #calc "1.8*$f50"; //floor legs from center; >0, preferably >=f50

//===================================================================

zb $yb;
yc $zc;

gradingFloor_inv #calc "1/($gradingFloor+0.0)";
gradingOuter_inv #calc "1/($gradingOuter+0.0)";

y2 #calc "$yc-$f50";
y3 #calc "$yc+$f50";

NH     #calc "round(2*$f50/$D*$ND)"; // Ncell per refinement block
delta0   #calc "2*$f50/$NH";
NL       #calc "round(($L)/$delta0*2/(1+$gradingDownstream))";
Nside    #calc "round(($w50-$f50)/$delta0*2/(1+$gradingOuter))";
Nfloor    #calc "round(($yc-$f50)/$delta0*2/(1+$gradingFloor))";

f50exp  #calc "$f50*$refinementExpansion";
y3exp   #calc "$yc+$f50exp";
zbexp   #calc "($zb-$f50)*($w50-$f50exp)/($w50-$f50)+$f50exp";
w50exp  #calc "$w50*$domainExpansion";
Hexp    #calc "$H*$domainExpansion";

vertices
(
    ( 0        -$w50   $y2 )   //0
    ($L        -$w50exp   $y2 )   //1
    (0          $f50  $y2 )  //2
    (0         -$w50  $H )   //3
    ($L        -$w50exp  $Hexp )   //4
    ($L         $f50exp  $y2 )  //5
    ($L         $f50exp  $y3exp )  //6
    (0          $f50  $y3 )  //7
    (0          $w50  $y2  )  //8
    ($L         $w50exp  $y2  )  //9
    ($L         $w50exp  $Hexp )  //10
    (0          $w50  $H )  //11

    ( 0        -$f50  $y2 )   //12
    ($L        -$f50exp  $y2 )   //13
    ($L        $w50exp  0 )     //14
    (0         -$f50  $y3 )   //15
    ($L        -$f50exp  $y3exp )   //16
    (0         -$w50  0 )     //17
    ($L        -$w50exp  0 )    //18
    (0         -$zb   0 )   //19
    ($L        -$zbexp   0 )  //20
    (0          $zb   0 )   //21
    ($L         $zbexp   0 )  //22
    (0          $w50  0 )  //23
    ($L         $w50exp  0 )  //24
);

blocks
(
    hex (0 1 13 12 3  4  16 15) ($NL  $Nside $NH) simpleGrading ($gradingDownstream $gradingOuter_inv 1) // left 0
    hex (12 13 5 2 15 16 6 7) ($NL   $NH $NH) simpleGrading ($gradingDownstream 1 1) // core 1
    hex (2 5 9 8 7 6 10 11) ($NL $Nside $NH   ) simpleGrading ($gradingDownstream $gradingOuter 1) // right 2
    hex (15 16 6 7 3 4 10 11) ($NL $NH $Nside ) simpleGrading ($gradingDownstream 1 $gradingOuter) // ceil 3

    hex (19 20 22 21 12 13 5 2) ($NL $NH $Nfloor ) simpleGrading ($gradingDownstream 1 $gradingFloor_inv) // floor center 4
    hex (17 18 20 19 0 1 13 12) ($NL $Nside $Nfloor) simpleGrading ($gradingDownstream $gradingOuter_inv $gradingFloor_inv) // floor left 5
    hex (21 22 24 23 2 5 9 8) ($NL $Nside $Nfloor) simpleGrading ($gradingDownstream $gradingOuter $gradingFloor_inv) // floor right 6
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (12 15 3 0)
            (7 11 3 15)
            (2 8 11 7)
            (2 21 23 8)
            (17 19 12 0)
            (19 21 2 12)
            (2 7 15 12)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (1 13 20 18)
            (4 16 13 1)
            (4 10 6 16)
            (6 10 9 5)
            (5 9 24 22)
            (13 5 22 20)
            (6 5 13 16)
        );
    }


    ceil
    {
        type patch;
        faces
        (
            (11 10 4 3)
        );
    }

    floor
    {
        type patch;
        faces
        (
            (19 20 22 21)
            (17 18 20 19)
            (21 22 24 23)
        );
    }


    side
    {
        type patch;
        faces
        (
            (4 1 0 3)
            (0 1 18 17)
            (11 8 9 10)
            (8 23 24 9)
        );
    }

    
);//*/

mergePatchPairs
