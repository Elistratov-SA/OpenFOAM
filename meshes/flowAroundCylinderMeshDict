// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Geometric parameters

r   0.5; // cylinder radius
CPD   20; // cells per diameter
nz       1; // 2D set-up

rOuter  ${{ 2*$r }};
xmax    ${{ 40*$r }};;
xmin    ${{ -4*$r }};;  // <0
ymax    ${{ 12*$r }};;
ymin    ${{ -12*$r }};; // <0

radialGrading  6;
downstreamGrading 5;
upstreamGrading  2;
verticalGrading 5;


zmin   -0.5;  // Back/front locations
zmax    0.5;





// ----------------

// Derived quantities
rInner45    ${{ $r * sqrt(0.5) }};
rOuter45    ${{ $rOuter * sqrt(0.5) }};

nRadial  ${{round($CPD/2/$r*($rOuter-$r))}};
nQuarter ${{round(3.14159*$rOuter/8*(1+1/$radialGrading)/($rOuter-$r)*$nRadial)}};//10;
nxOuter_upstream  ${{round((1+1/$radialGrading)*(-$rOuter-$xmin)/(1+1/$upstreamGrading)/($rOuter-$r)*$nRadial/2)}};
nxOuter_downstream  ${{round((1+1/$radialGrading)*($xmax-$rOuter)/(1+$downstreamGrading)/($rOuter-$r)*$nRadial)}};;
nyOuter_up  ${{round(($ymax-$rOuter45)*2/(1+$verticalGrading)/$rOuter45*$nQuarter)}};
nyOuter_down $nyOuter_up;


radialGrading_inv ${{1/$radialGrading}};
verticalGrading_down ${{1/$verticalGrading}};
upstreamGrading_inv ${{1/$upstreamGrading}};

vertices #codeStream
{
    codeInclude
    #{
        #include "pointField.H"
    #};

    code
    #{
        pointField points
        ({
            /* 0*/ { $r, 0, $zmin },
            /* 1*/ { $rOuter, 0, $zmin },
            /* 2*/ { $xmax, 0, $zmin },
            /* 3*/ { $xmax, $rOuter45, $zmin },
            /* 4*/ { $rOuter45, $rOuter45, $zmin },
            /* 5*/ { $rInner45, $rInner45, $zmin },
            /* 6*/ { $xmax, $ymax, $zmin },
            /* 7*/ { $rOuter45, $ymax, $zmin },
            /* 8*/ { 0, $ymax, $zmin },
            /* 9*/ { 0, $rOuter, $zmin },
            /*10*/ { 0, $r, $zmin },
            /*11*/ { -$r, 0, $zmin },
            /*12*/ { -$rOuter, 0, $zmin },
            /*13*/ {  $xmin, 0, $zmin },
            /*14*/ {  $xmin, $rOuter45, $zmin },
            /*15*/ { -$rOuter45, $rOuter45, $zmin },
            /*16*/ { -$rInner45, $rInner45, $zmin },
            /*17*/ {  $xmin, $ymax, $zmin },
            /*18*/ { -$rOuter45, $ymax, $zmin },

            /* 19*/ { $r, 0, $zmin },
            /* 20*/ { $rOuter, 0, $zmin },
            /* 21*/ { $xmax, 0, $zmin },
            /* 22*/ { $xmax, -$rOuter45, $zmin },
            /* 23*/ { $rOuter45, -$rOuter45, $zmin },
            /* 24*/ { $rInner45, -$rInner45, $zmin },
            /* 25*/ { $xmax, $ymin, $zmin },
            /* 26*/ { $rOuter45, $ymin, $zmin },
            /* 27*/ { 0, $ymin, $zmin },
            /* 28*/ { 0, -$rOuter, $zmin },
            /*29*/ { 0, -$r, $zmin },
            /*30*/ { -$r, 0, $zmin },
            /*31*/ { -$rOuter, 0, $zmin },
            /*32*/ {  $xmin, 0, $zmin },
            /*33*/ {  $xmin, -$rOuter45, $zmin },
            /*34*/ { -$rOuter45, -$rOuter45, $zmin },
            /*35*/ { -$rInner45, -$rInner45, $zmin },
            /*36*/ {  $xmin, $ymin, $zmin },
            /*37*/ { -$rOuter45, $ymin, $zmin }
        });

        // Duplicate z points for zmax
        const label sz = points.size();
        points.resize(2*sz);
        for (label i = 0; i < sz; ++i)
        {
            const point& pt = points[i];
            points[i + sz] = point(pt.x(), pt.y(), $zmax);
        }

        os  << points;
    #};
};

// Can remove unneeded variables
#remove ( "r(Inner|Outer).*"  "[xy](min|max)" )

