forcesAll
{
    type          forces;
    libs          (forces);

    writeControl  timeStep;
    timeInterval  1;

    patches       ("cylinder" );
    rho           rhoInf;
    rhoInf	  1.225;     // Indicates incompressible
    log           true;

    CofR          (0 0 0);    // Rotation around centre line of propeller
    pitchAxis     (1 0 0);
}

